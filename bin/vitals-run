#!/usr/bin/env python3
"""Run a command in its own systemd user scope so Vitals can attribute it.

Usage: vitals-run [--name LABEL] [--] COMMAND [ARGS...]
"""
import os
import re
import secrets
import shutil
import sys
from pathlib import Path
import uuid

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from vitals.jobs import project_info, supervise
import subprocess

USAGE = 'usage: vitals-run [--name LABEL] [--] COMMAND [ARGS...]'
MAX_LABEL = 24


def sanitize_label(value):
    label = re.sub(r'[^a-z0-9]+', '-', str(value).lower()).strip('-')[:MAX_LABEL].strip('-')
    return label or 'app'


def build_argv(label, command, suffix=None, systemd_run='systemd-run'):
    label = sanitize_label(label)
    suffix = suffix or secrets.token_hex(3)
    return [systemd_run, '--user', '--scope', '--quiet', '--collect',
            '--unit=agent-%s-%s' % (label, suffix),
            '--description=Vitals: %s' % label, '--property=CPUAccounting=yes',
            '--property=MemoryAccounting=yes', '--property=IOAccounting=yes', '--'] + list(command)


def parse(args):
    name = None
    args = list(args)
    while args:
        if args[0] == '--':
            args.pop(0)
            break
        if args[0] == '--name' and len(args) > 1:
            name = args[1]
            del args[:2]
        elif args[0].startswith('--name='):
            name = args.pop(0)[7:]
        else:
            break
    return name, args


def manager_available():
    try:
        return subprocess.run(['systemctl', '--user', 'show-environment'], stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=1).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def main(args=None):
    args = sys.argv[1:] if args is None else list(args)
    if args in (['--help'], ['-h']):
        print(USAGE + '\nUse --shell-init to print optional agent aliases.')
        return 0
    if args == ['--shell-init']:
        import shlex
        launcher = shlex.quote(str(Path(__file__).resolve()))
        for command in ('claude', 'codex', 'opencode', 'gemini'):
            print(f'alias {command}={shlex.quote(launcher + " -- " + command)}')
        return 0
    if args and args[0] == '--worker':
        ident, label, project_id, project = args[1:5]
        return supervise(args[6:], label, ident, {'project_id': project_id, 'project': project})
    name, command = parse(args)
    if not command:
        print(USAGE, file=sys.stderr)
        return 2
    label = name if name is not None else os.path.basename(command[0])
    label = sanitize_label(label)
    systemd_run = shutil.which('systemd-run')
    if systemd_run and os.environ.get('XDG_RUNTIME_DIR') and manager_available():
        ident = uuid.uuid4().hex
        project = project_info()
        worker = [sys.executable, '-B', str(Path(__file__).resolve()), '--worker',
                  ident, label, project['project_id'], project['project'], '--'] + command
        argv = build_argv(label, worker, suffix=ident, systemd_run=systemd_run)
    else:
        print('vitals-run: systemd user manager not available; running without a scope', file=sys.stderr)
        return supervise(command, label, uuid.uuid4().hex)
    try:
        os.execvp(argv[0], argv)
    except OSError as error:
        print('vitals-run: %s: %s' % (argv[0], error.strerror), file=sys.stderr)
        return 127 if isinstance(error, FileNotFoundError) else 126


if __name__ == '__main__':
    sys.exit(main())
